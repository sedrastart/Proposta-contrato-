# Copie para .env e preencha os valores reais. Nunca comite o .env de verdade.

# Banco de dados. Em desenvolvimento local (SQLite): file:./prisma/dev.db
# Em produção (Supabase/Postgres): a "Connection string" do painel do
# Supabase — Project Settings > Database > Connection string (modo "URI").
DATABASE_URL=""

# Necessárias apenas quando os documentos gerados (PDF/DOCX) devem ir para o
# Supabase Storage em vez do disco local. Sem elas, o sistema usa a pasta
# ./storage automaticamente (só funciona em ambientes com disco persistente,
# não na Vercel).
# Painel do Supabase > Project Settings > API.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
